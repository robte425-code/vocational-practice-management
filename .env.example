# Copy to .env.local for email delivery via Postmark. Required in production:
# without POSTMARK_SERVER_TOKEN, EMAIL_FROM and DEMO_INBOX_EMAIL the demo form returns 503.
# Use the same Postmark vars as the Requests app (TEAM Tickets).
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=Vocational Practice Management <noreply@your-verified-domain>
# Optional; defaults to "outbound"
# POSTMARK_MESSAGE_STREAM=outbound

# Where demo lead emails are delivered
DEMO_INBOX_EMAIL=demos@your-domain
